# 依赖
node_modules/

# 打包产物（npm pack 会在这里生成 .tgz）
*.tgz

# 日志与临时文件
*.log
*.tmp
*.bak

# 独立软件的数据目录（里面是真实记忆，绝不进版本库）
app/data/

# 编辑器 / 系统垃圾
.DS_Store
Thumbs.db
.idea/
.vscode/

dist/


# 防御：任何层级的 data 目录（含误操作产生的套娃）都不进版本库
**/data/
*.db
*.db-wal
*.db-shm
*config*.json
*.tgz

