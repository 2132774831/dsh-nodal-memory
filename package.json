{
  "name": "dsh-local-memory",
  "version": "2.5.6",
  "description": "DeepSeek Harness 纯本地长期记忆：跨对话、跨项目，数据只存本机。默认不联网、不需要 API key；语义检索和关系图可选。附带独立界面（关系图 / 直觉 / 设置），插件只做数据接口和跳转。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "local-memory",
    "long-term-memory",
    "offline"
  ],
  "type": "module",
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/host/client.js",
    "./core": "./src/core/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "app",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
